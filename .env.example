DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=

# Cấu hình ứng dụng
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

FRONTEND_URLS=http://localhost:3000
NODE_ENV=development

# Redis
REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Cấu hình RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com

RPC_ETH=your_eth_rpc_url  # Fallback
RPC_BNB=your_bnb_rpc_url  # Fallback
# Tối đa số lần gọi RPC/giây (chung SOL/ETH/BNB, tránh giới hạn Quicknode); không set hoặc invalid => 50
RPC_RATE_LIMIT_PER_SECOND=50

ZERION_API_KEY=

# Block Explorer API Keys
SOLSCAN_API_KEY=your_solana_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
BSCSCAN_API_KEY=your_bscscan_api_key_here

WALLET_SEED=your 24 word mnemonic phrase here

WALLET_CEO_ETH=
WALLET_CEO_BNB=
WALLET_CEO_SOL=


# Cấu hình JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

#Thiết lập múi giờ 
TZ=Asia/Ho_Chi_Minh
