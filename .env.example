DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=

# Cấu hình ứng dụng
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# From address hiển thị trong email (EmailService fallback nếu không set)
SMTP_FROM=

FRONTEND_URLS=http://localhost:3000
# Admin frontend URLs - sử dụng admin_access_token cho requests từ các URLs này
ADMIN_FRONTEND_URLS=http://localhost:3001
# Link trong email (SMTP); khác FRONTEND_URLS (CORS)
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false
SENTRY_ENABLE_LOGS=true

# Nest Logger: info | error | warn | debug | verbose (main.ts dùng debug khi LOG_LEVEL=debug)
LOG_LEVEL=info

# Google OAuth (đăng nhập Google — đổi code server-side)
# FRONTEND_URL_GOOGLE_REDIRECT = base URL callback (không có path cuối); redirect_uri = base + /google-login (hoặc path client gửi)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL_GOOGLE_REDIRECT=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# KYC: thời gian hiệu lực mã cầm giấy (phút), mặc định 1440 = 24h
KYC_CHALLENGE_TTL_MINUTES=1440

# Cấu hình RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WSS_URL=wss://api.mainnet-beta.solana.com

RPC_ETH=your_eth_rpc_url  # Fallback (mainnet hoặc Sepolia — khớp với contract trong DB)
RPC_BNB=your_bnb_rpc_url  # Fallback
# Arbitrum (khi dùng network net_symbol=ARB trong DB)
RPC_ARB=
# Tron — đồng bộ nạp (scheduler + TronGrid v1). Tên biến phải khớp networks.net_symbol: TRX → RPC_TRX, TRON → RPC_TRON
# Full node / TronGrid host (ví dụ mainnet https://api.trongrid.io, Shasta https://api.shasta.trongrid.io, Nile https://nile.trongrid.io)
RPC_TRX=
# RPC_TRON=
# Header Tron-Pro-Api-Key (TronGrid); có thể dùng TRON_API_KEY thay thế
TRONGRID_API_KEY=
# TRON_API_KEY=
# Tối đa số lần gọi RPC/giây (chung SOL/ETH/BNB, tránh giới hạn Quicknode); không set hoặc invalid => 50
RPC_RATE_LIMIT_PER_SECOND=50

ZERION_API_KEY=

# Giá token (ví dụ USDT) — endpoint CoinGecko simple price
COINGECKO_SIMPLE_PRICE_URL=https://api.coingecko.com/api/v3/simple/price

# Block Explorer API Keys (đồng bộ nạp EVM: native txlist / token tokentx; không bắt buộc nếu chỉ dùng quét RPC)
SOLSCAN_API_KEY=your_solana_api_key_here
# Etherscan API V2 — ETH + BNB (BSC) + Arbitrum: một URL + một key, chỉ đổi chain id (https://docs.etherscan.io/v2-api)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
# Tùy chọn: key BscScan riêng (nếu sau này dùng API BscScan; hiện EVM sync chủ yếu dùng ETHERSCAN_API_URL V2 + chain id)
BSCSCAN_API_KEY=
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api
# Ethereum: 1 = mainnet, 11155111 = Sepolia
ETHERSCAN_CHAIN_ID=1
# BNB Chain (BSC): 56 = mainnet, 97 = testnet
BNB_CHAIN_ID=56
# Arbitrum One: 42161 = mainnet, 421614 = Sepolia
ARB_CHAIN_ID=42161

WALLET_SEED=your 24 word mnemonic phrase here

WALLET_CEO_ETH=
WALLET_CEO_BNB=
WALLET_CEO_SOL=

# 2FA / TOTP (issuer hiển thị trên app — UserSecurityService dùng APP_NAME)
APP_NAME=YourApp
APP_DESCRIPTION=
APP_LOGO=

# Cấu hình JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# Phí lệnh orderbook (phần trăm, ví dụ 0.5 = 0.5%)
FEE_PERCENT=0

#Thiết lập múi giờ
TZ=Asia/Ho_Chi_Minh
